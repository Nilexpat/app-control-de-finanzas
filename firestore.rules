rules_version = '2';

// Reglas de Firestore para SocioFinanzas.
//
// LEER ANTES DE PUBLICAR
// Estas reglas van EMPAREJADAS con la version de la app que se une a una
// empresa con un lote atomico (FirestoreRepository.joinWithInvitation). Una app
// anterior no podra aceptar invitaciones con estas reglas, y esta app no puede
// aceptarlas con las reglas anteriores: hay que publicar ambas cosas a la vez.
// Antes de publicar, comprobar en la consola que el campo `memberUids` de cada
// empresa contiene el UID de TODOS sus socios activos: quien no figure ahi
// pierde el acceso.
//
// Estructura:
//   users/{uid}
//   invitations/{codigo}           -> el id del documento ES el codigo
//   groups/{groupId}               -> incluye memberUids: [uid, ...]
//     members/{memberId}
//     movements/{movementId}
//     products/{productId}
//     transferAccounts/{accountId}
//     settlements/{settlementId}
//
// MODELO DE ACCESO
// Solo quien figura en `memberUids` de la empresa puede leer o escribir la
// empresa y su contenido. La unica puerta de entrada para alguien de fuera es
// aceptar una invitacion valida, y debe hacerlo en UNA sola escritura atomica
// con tres partes que se validan entre si:
//   1. su ficha        groups/{g}/members/user_{g}_{uid}   (con `inviteCode`)
//   2. la lista        groups/{g}.memberUids  += su uid
//   3. la invitacion   invitations/{codigo}.usedCount += 1
// Si falta cualquiera de las tres, o la invitacion esta caducada, revocada o
// agotada, se rechaza el lote entero.
//
// LIMITACION CONOCIDA
// Dentro de una empresa, las reglas no distinguen administrador de socio: los
// permisos por rol los aplica la app. Un socio con un cliente modificado podria
// saltarselos. Cerrarlo exige guardar los administradores en el documento del
// grupo (por ejemplo `adminUids`).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function invitationPath(code) {
      return /databases/$(database)/documents/invitations/$(code);
    }

    // El usuario autenticado figura en la lista de acceso de esos datos de grupo
    function isListedMember(groupData) {
      return isAuthenticated()
             && groupData.memberUids is list
             && request.auth.uid in groupData.memberUids;
    }

    // Pertenece al grupo segun lo que hay guardado AHORA en el servidor
    function isGroupMember(groupId) {
      return isAuthenticated() && isListedMember(get(groupPath(groupId)).data);
    }

    // No pertenecia al grupo y, al terminar esta misma escritura, si pertenece
    function isEnteringGroup(groupId) {
      return isAuthenticated()
             && !isListedMember(get(groupPath(groupId)).data)
             && isListedMember(getAfter(groupPath(groupId)).data);
    }

    // --- Perfil de usuario ---
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // --- Invitaciones ---
    // El codigo de 8 caracteres (32^8 combinaciones) hace de secreto y es el id
    // del documento: quien lo conoce puede leer ESA invitacion, pero nadie de
    // fuera puede listar las invitaciones de una empresa.
    match /invitations/{code} {
      allow get: if isAuthenticated();
      allow list: if isGroupMember(resource.data.groupId);

      allow create: if isGroupMember(request.resource.data.groupId)
                    && request.resource.data.code == code
                    && request.resource.data.usedCount == 0;

      allow update: if (isGroupMember(resource.data.groupId)
                        && request.resource.data.groupId == resource.data.groupId
                        && request.resource.data.code == resource.data.code)
                    || isConsumingInvitation();

      allow delete: if isGroupMember(resource.data.groupId);

      // Parte 3 de la union: un no-miembro gasta UN uso de una invitacion
      // vigente, y solo si en esta misma escritura entra en la empresa.
      function isConsumingInvitation() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
               && request.resource.data.usedCount == resource.data.usedCount + 1
               && resource.data.usedCount < resource.data.maxUses
               && resource.data.isRevoked != true
               && request.time.toMillis() < resource.data.expiresAt
               && isEnteringGroup(resource.data.groupId);
      }
    }

    // --- Grupos ---
    match /groups/{groupId} {
      // La consulta `whereArrayContains("memberUids", uid)` de la app cumple
      // esta condicion, asi que cada cuenta sigue descubriendo sus empresas.
      // Se escribe sin `is list` a proposito: con esa comprobacion Firestore
      // no sabe validar la consulta y la rechaza entera.
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberUids;

      // Quien crea la empresa debe figurar en ella desde el principio
      allow create: if isListedMember(request.resource.data)
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;

      allow update: if isListedMember(resource.data) || isJoining();

      allow delete: if isListedMember(resource.data);

      // Parte 2 de la union: un no-miembro solo puede anadirse A SI MISMO a la
      // lista, sin tocar nada mas, y solo si esta misma escritura deja su ficha
      // activa y gasta un uso de la invitacion con la que entra.
      function isJoining() {
        let fichaPath = /databases/$(database)/documents/groups/$(groupId)/members/$("user_" + groupId + "_" + request.auth.uid);
        let ficha = getAfter(fichaPath).data;
        let invitacionAntes = get(invitationPath(ficha.inviteCode)).data;
        let invitacionDespues = getAfter(invitationPath(ficha.inviteCode)).data;
        return isAuthenticated()
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
               && !(request.auth.uid in resource.data.memberUids)
               && request.auth.uid in request.resource.data.memberUids
               && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
               && request.resource.data.memberUids.hasAll(resource.data.memberUids)
               && ficha.googleUid == request.auth.uid
               && ficha.active == true
               && invitacionAntes.groupId == groupId
               && invitacionDespues.usedCount == invitacionAntes.usedCount + 1;
      }

      match /members/{memberId} {
        allow read, delete: if isGroupMember(groupId);
        allow create, update: if isGroupMember(groupId) || isOwnJoinFicha();

        // Parte 1 de la union: la ficha propia, con el id que usa la app, el
        // rol que concede la invitacion y los valores iniciales de un socio
        // nuevo (20% y sin deuda: los mismos que pone buildInvitedMember).
        function isOwnJoinFicha() {
          let ficha = request.resource.data;
          let invitacion = get(invitationPath(ficha.inviteCode)).data;
          return isAuthenticated()
                 && memberId == "user_" + groupId + "_" + request.auth.uid
                 && ficha.id == memberId
                 && ficha.groupId == groupId
                 && ficha.googleUid == request.auth.uid
                 && ficha.active == true
                 && ficha.sharePercentCentecimas == 2000
                 && ficha.initialDebtCop == 0
                 && invitacion.groupId == groupId
                 && ficha.role == invitacion.role
                 && isEnteringGroup(groupId);
        }
      }

      // Contenido financiero: solo miembros de la empresa
      match /movements/{movementId} {
        allow read, write: if isGroupMember(groupId);
      }

      match /products/{productId} {
        allow read, write: if isGroupMember(groupId);
      }

      match /transferAccounts/{accountId} {
        allow read, write: if isGroupMember(groupId);
      }

      match /settlements/{settlementId} {
        allow read, write: if isGroupMember(groupId);
      }
    }
  }
}
