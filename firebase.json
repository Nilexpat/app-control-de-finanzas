{
  "firestore": [
    {
      "database": "ai-studio-android-sociofin-f5c4d9c9-4d8d-45b8-8b46-ebee3a314cda",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/unirse/**",
        "destination": "/unirse/index.html"
      }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ]
  }
}
