{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile authenticated with Google Account",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Group": {
      "title": "Group",
      "description": "Business or financial group entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "ownerId"]
    },
    "Member": {
      "title": "Member",
      "description": "Partner or collaborator in a business group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "SOCIO"] },
        "active": { "type": "boolean" },
        "sharePercentCentecimas": { "type": "integer" },
        "initialDebtCop": { "type": "integer" }
      },
      "required": ["id", "groupId", "name", "email", "role"]
    },
    "Movement": {
      "title": "Movement",
      "description": "Financial income, expense, or loan movement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "type": { "type": "string", "enum": ["VENTA", "COMPRA", "PRESTAMO"] },
        "amountCop": { "type": "integer" },
        "concept": { "type": "string" },
        "createdByUserId": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "type", "amountCop", "concept", "createdByUserId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile documents"
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/Group" },
      "description": "Business groups"
    },
    "/groups/{groupId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/Member" },
      "description": "Group members"
    },
    "/groups/{groupId}/movements/{movementId}": {
      "schema": { "$ref": "#/entities/Movement" },
      "description": "Financial movements recorded within a group"
    }
  }
}
